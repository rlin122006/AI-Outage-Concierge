<Window x:Class="larp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="L.A.R.P. — Likelihood Assessment and Reporting for Power outages" Height="850" Width="1360" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="White" Foreground="#17191C" Icon="/src/Assets/larp.ico"
        FontFamily="Segoe UI" UseLayoutRounding="True" WindowStyle="None" ResizeMode="CanResize" Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#6D737A"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17191C"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="#17191C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#17191C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#17365D"/><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#17365D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#102744"/><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#102744"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="Foreground" Value="#30353A"/></Style>
        <Style x:Key="ComboDropButtonStyle" TargetType="ToggleButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17191C"/><Setter Property="BorderBrush" Value="#C9CFD4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2,1"/><Setter Property="Foreground" Value="#17191C"/><Setter Property="Background" Value="White"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E7EBF0"/><Setter Property="Foreground" Value="#17191C"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#DCEBFF"/><Setter Property="Foreground" Value="#17365D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboSurface" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False"/><ToggleButton x:Name="DropButton" Style="{StaticResource ComboDropButtonStyle}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Width="Auto" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#555B61" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#C9CFD4" BorderThickness="1" CornerRadius="6" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0"><ScrollViewer CanContentScroll="True" MaxHeight="260" Focusable="False"><ItemsPresenter x:Name="PART_ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#555B61"/><Setter TargetName="ComboSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#555B61"/><Setter TargetName="ComboSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#30353A"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#DCEBFF"/><Setter Property="Foreground" Value="#17365D"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#C5DCFF"/><Setter Property="Foreground" Value="#17365D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ScrollBar"><Setter Property="Width" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="#C4CCD4" CornerRadius="5" Margin="3,1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#8DB8F5"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#7FA6D9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E1E4E7" BorderThickness="0,0,0,1" Padding="22,13" MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Width="42" Height="38" Padding="0" Margin="0,0,6,0" Background="Transparent" Foreground="#30353A" BorderBrush="Transparent" ToolTip="Minimize" Click="MinimizeWindow_Click"><Path Data="M 1 7 L 13 7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Square"/></Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="FullScreenButton" Width="42" Height="38" Padding="0" Margin="0,0,6,0" Background="Transparent" Foreground="#30353A" BorderBrush="Transparent" ToolTip="Enter full screen" Click="ToggleFullScreen_Click"><Path x:Name="FullScreenIcon" Data="M 1.5 1.5 H 12.5 V 12.5 H 1.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Width="42" Height="38" Padding="0" Background="Transparent" Foreground="#30353A" BorderBrush="Transparent" ToolTip="Close" Click="CloseWindow_Click"><Path Data="M 2 2 L 12 12 M 12 2 L 2 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/src/Assets/larp.png" Width="46" Height="46" Margin="0,0,10,0" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AEP  /  HACKOHI/O 2026" FontSize="10" Foreground="#72777D" FontWeight="SemiBold"/>
                        <TextBlock Text="L.A.R.P." FontSize="24" FontWeight="Bold" Margin="0,1,0,0"/>
                        <TextBlock Text="Likelihood Assessment and Reporting for Power outages" FontSize="12" Foreground="#646A70"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" Background="#F4F5F6" VerticalScrollBarVisibility="Auto"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.24*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <StackPanel><TextBlock Text="Your situation" FontSize="18" FontWeight="Bold"/><TextBlock Text="Choose a map location and scenario assumptions." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                        <DockPanel Margin="0,2,0,8"><TextBlock Text="Map" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="Scroll to zoom · drag to pan" Foreground="#777D83" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/></DockPanel>
                        <Border BorderBrush="#CFD4D8" BorderThickness="1" CornerRadius="4" Height="320" ClipToBounds="True"><mapsui:MapControl x:Name="AreaMapControl" MapTapped="AreaMapControl_MapTapped" MouseWheel="AreaMapControl_MouseWheel"/></Border>
                        <TextBlock x:Name="CoordinateText" Text="Loading historical damage layer…" Foreground="#6D737A" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Text="Select a point to view the local estimate. Coverage is shown only where the dataset contains observations." Foreground="#777D83" FontSize="11" Margin="0,3,0,0"/>
                        <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="CoverageLayerCheck" Margin ="0,0,8,0" Content="Damage coverage" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="PremisesLayerCheck" Content="Premises" Margin ="0,0,8,0" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="ConductorLayerCheck" Margin = "0,0,8,0" Content="Conductors" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="PolesLayerCheck" Margin="0,0,8,0" Content="Poles" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="TransformerLayerCheck" Margin="0,0,8,0" Content="Transformers" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="ProtectionLayerCheck" Margin="0,0,8,4" Content="Protection" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/></WrapPanel>
                        <TextBlock Text="Map tiles load from OpenStreetMap when online. Data coverage is limited to the shaded area." Foreground="#777D83" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock x:Name="NetworkText" Text="Select a location to inspect nearby network context." Foreground="#555B61" FontSize="12" Margin="0,3,0,0"/>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Storm severity" FontWeight="SemiBold"/><ComboBox x:Name="StormCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="Lower severity · ×0.75" Tag="0.75"/><ComboBoxItem Content="Typical severity · ×1.00" Tag="1.0" IsSelected="True"/><ComboBoxItem Content="Higher severity · ×1.35" Tag="1.35"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Asset exposure" FontWeight="SemiBold"/><ComboBox x:Name="ExposureCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="Use local GIS mix" Tag="auto" IsSelected="True"/><ComboBoxItem Content="Overhead scenario · ×1.20" Tag="1.2"/><ComboBoxItem Content="Underground scenario · ×0.80" Tag="0.8"/></ComboBox></StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Restoration crew" FontWeight="SemiBold"/><ComboBox x:Name="CrewCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="2 people" Tag="2"/><ComboBoxItem Content="4 people" Tag="4" IsSelected="True"/><ComboBoxItem Content="6 people" Tag="6"/><ComboBoxItem Content="8 people" Tag="8"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Work access" FontWeight="SemiBold"/><ComboBox x:Name="AccessCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="Standard access · +0 h/job" Tag="0" IsSelected="True"/><ComboBoxItem Content="Restricted access · +0.5 h/job" Tag="0.5"/><ComboBoxItem Content="Remote access · +1.312 h/job" Tag="1.312"/></ComboBox></StackPanel></Grid>
                        <TextBlock Text="Storm multipliers are scenario assumptions. Asset exposure uses local overhead/underground GIS data unless overridden." Foreground="#777D83" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="Additional needs" FontWeight="SemiBold" Margin="0,18,0,2"/><CheckBox x:Name="MedicalCheck" Content="I rely on electrically powered medical equipment" Checked="Needs_Changed" Unchecked="Needs_Changed"/><CheckBox x:Name="AccessCheck" Content="I may need extra assistance during an outage" Checked="Needs_Changed" Unchecked="Needs_Changed"/><CheckBox x:Name="CriticalCheck" Content="This is a critical community facility" Checked="Needs_Changed" Unchecked="Needs_Changed"/>
                        <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,12,0,2"/><CheckBox x:Name="SmsCheck" Content="Opt in to SMS outage alerts (prototype)" Checked="AlertPreference_Changed" Unchecked="AlertPreference_Changed"/><CheckBox x:Name="EmailCheck" Content="Opt in to email updates (prototype)" Checked="AlertPreference_Changed" Unchecked="AlertPreference_Changed"/>
                        <Button x:Name="PredictButton" Content="View my estimate" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="PredictButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Your outage outlook" FontSize="18" FontWeight="Bold"/><TextBlock Text="Historical planning index · not a confirmed utility report" Foreground="#6D737A" FontSize="12" Margin="0,3,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RELATIVE DAMAGE INDEX" FontSize="11" FontWeight="Bold" Foreground="#6D737A"/><TextBlock x:Name="RiskValue" Text="— / 100" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock x:Name="RiskConfidence" Text="Select a location in the data coverage." Foreground="#6D737A" FontSize="12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="RISK BAND" FontSize="11" FontWeight="Bold" Foreground="#6D737A"/><TextBlock x:Name="RiskBandValue" Text="Not available" FontSize="23" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Not an outage probability" Foreground="#6D737A" FontSize="12"/></StackPanel></Grid></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Restoration scenario" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="RestorationValue" Text="Not available" FontSize="20" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="RestorationDetailsText" Text="Select a location to estimate repair effort from the historical local damage mix." Foreground="#555B61" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="What affects the estimate" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="FactorsText" Text="Choose a location within the historical GIS coverage to calculate a relative score." Foreground="#555B61" Margin="0,7,0,0"/><TextBlock Text="How to read this score" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBlock Text="The baseline blends distance-weighted historical damage (75%) and nearby premises/network density (25%). Storm severity multiplies the baseline. Local overhead share supplies the default asset-exposure factor; scenario overrides can be selected. The 0–100 result is a relative index, not a calibrated outage probability or live forecast." Foreground="#555B61"/><TextBlock Text="Restoration assumptions" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBlock Text="ARCOS reports are historical. Work estimates use the supplied installation/removal averages, phase-aware pole hardware allowances, the 4.5 indirect labor multiplier, crew size, and access adders. The displayed duration applies an illustrative −25%/+35% buffer. Nearby sectionalizing devices are shown as restoration opportunities; actual switching sequence and step restoration are not simulated." Foreground="#555B61"/></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Prepare" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="PreparationLevelText" Text="Risk-based guidance" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="GuidanceText" Text="Select a location and view an estimate for guidance tailored to its historical index." Foreground="#555B61" Margin="0,3,0,0"/><TextBlock Text="SAFETY · EMERGENCY" FontSize="10" FontWeight="Bold" Foreground="#9B2C2C" Margin="0,12,0,2"/><TextBlock x:Name="SafetyGuidanceText" Text="Downed lines may still be energized, so stay away and call emergency services and your utility. If anyone is in immediate danger, call emergency services." Foreground="#555B61"/><TextBlock Text="Alert eligibility" FontWeight="SemiBold" Margin="0,13,0,2"/><TextBlock x:Name="EligibilityText" Text="Alerts are off. Opt in to SMS or email to see the prototype alert plan." Foreground="#555B61"/><StackPanel x:Name="AlertPlanPanel" Visibility="Collapsed"><TextBlock x:Name="AlertPlanText" Foreground="#555B61" Margin="0,7,0,0"/><TextBlock Text="MESSAGE PREVIEWS · NOT SENT" FontSize="10" FontWeight="Bold" Foreground="#6D737A" Margin="0,13,0,5"/><TextBlock Text="Pre-storm" FontWeight="SemiBold"/><TextBlock x:Name="PreStormMessageText" Foreground="#555B61" Margin="0,2,0,8"/><TextBlock Text="Outage confirmed" FontWeight="SemiBold"/><TextBlock x:Name="OutageConfirmedMessageText" Foreground="#555B61" Margin="0,2,0,8"/><TextBlock Text="Estimate updated" FontWeight="SemiBold"/><TextBlock x:Name="EstimateUpdatedMessageText" Foreground="#555B61" Margin="0,2,0,8"/><TextBlock Text="Restoration complete" FontWeight="SemiBold"/><TextBlock x:Name="RestorationCompleteMessageText" Foreground="#555B61" Margin="0,2,0,0"/></StackPanel></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Ask the outage assistant" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="ChatStatusText" Text="Checking local settings…" Foreground="#858A8F" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/></StackPanel><Border Grid.Row="1" Background="#F5F6F7" CornerRadius="5" Padding="12" Margin="0,12,0,10"><TextBlock x:Name="ChatResponse" Text="The assistant is starting." Foreground="#444A50"/></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" Margin="0" VerticalContentAlignment="Center" ToolTip="Ask about your estimate or preparation" KeyDown="ChatInput_KeyDown"/><Button x:Name="SendButton" Grid.Column="2" Content="Send" Padding="16,8" Click="SendButton_Click"/></Grid></Grid></Border>
                <TextBlock Text="Prototype only · Not an official outage notice or emergency service" Foreground="#777D83" FontSize="11" Margin="2,12,0,10"/>
            </StackPanel>
        </Grid></ScrollViewer>
    </Grid>
</Window>
