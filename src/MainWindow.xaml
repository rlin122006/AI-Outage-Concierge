<Window x:Class="AI_Outage_Concierge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="Outage Concierge" Height="900" Width="1440" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#F4F5F6" Foreground="#17191C"
        FontFamily="Segoe UI" UseLayoutRounding="True" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#6D737A"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17191C"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="#17191C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="Foreground" Value="#30353A"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E1E4E7" BorderThickness="0,0,0,1" Padding="28,18">
            <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="AEP  /  HACKOHI/O 2026" FontSize="11" Foreground="#72777D" FontWeight="SemiBold"/><TextBlock Text="Outage Concierge" FontSize="23" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="Predict. Explain. Prepare." Foreground="#646A70" VerticalAlignment="Center" FontSize="13"/></DockPanel>
        </Border>
        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="26"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.24*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,16">
                    <StackPanel><TextBlock Text="Your situation" FontSize="18" FontWeight="Bold"/><TextBlock Text="Choose a map location and scenario assumptions." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                        <DockPanel Margin="0,2,0,8"><Button Content="Fit coverage" Padding="10,5" Click="CoverageView_Click"/><TextBlock Text="  Scroll to zoom · drag to pan" Foreground="#777D83" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/></DockPanel>
                        <Border BorderBrush="#CFD4D8" BorderThickness="1" CornerRadius="4" Height="320" ClipToBounds="True"><Grid><mapsui:MapControl x:Name="AreaMapControl" MapTapped="AreaMapControl_MapTapped"/><Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#F4FFFFFF" Padding="5,2" Margin="0,0,5,5" IsHitTestVisible="False"><TextBlock Text="© OpenStreetMap contributors" FontSize="10" Foreground="#4E555A"/></Border></Grid></Border>
                        <TextBlock x:Name="CoordinateText" Text="Loading historical damage layer…" Foreground="#6D737A" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Text="Select a point to view the local estimate. Coverage is shown only where the dataset contains observations." Foreground="#777D83" FontSize="11" Margin="0,3,0,0"/>
                        <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="CoverageLayerCheck" Content="Damage coverage" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="PremisesLayerCheck" Content="Premises" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="ConductorLayerCheck" Content="Conductors" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="PolesLayerCheck" Content="Poles" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="TransformerLayerCheck" Content="Transformers" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/><CheckBox x:Name="ProtectionLayerCheck" Content="Protection" IsChecked="False" Checked="Layer_Changed" Unchecked="Layer_Changed"/></WrapPanel>
                        <TextBlock Text="Map tiles load from OpenStreetMap when online. Data coverage is limited to the shaded area." Foreground="#777D83" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock x:Name="NetworkText" Text="Select a location to inspect nearby network context." Foreground="#555B61" FontSize="12" Margin="0,3,0,0"/>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Storm severity" FontWeight="SemiBold"/><ComboBox x:Name="StormCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="Lower severity · ×0.75" Tag="0.75"/><ComboBoxItem Content="Typical severity · ×1.00" Tag="1.0" IsSelected="True"/><ComboBoxItem Content="Higher severity · ×1.35" Tag="1.35"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Asset exposure" FontWeight="SemiBold"/><ComboBox x:Name="ExposureCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="Use local GIS mix" Tag="auto" IsSelected="True"/><ComboBoxItem Content="Overhead scenario · ×1.20" Tag="1.2"/><ComboBoxItem Content="Underground scenario · ×0.80" Tag="0.8"/></ComboBox></StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Restoration crew" FontWeight="SemiBold"/><ComboBox x:Name="CrewCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="2 people" Tag="2"/><ComboBoxItem Content="4 people" Tag="4" IsSelected="True"/><ComboBoxItem Content="6 people" Tag="6"/><ComboBoxItem Content="8 people" Tag="8"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Work access" FontWeight="SemiBold"/><ComboBox x:Name="AccessCombo" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="Standard access · +0 h/job" Tag="0" IsSelected="True"/><ComboBoxItem Content="Restricted access · +0.5 h/job" Tag="0.5"/><ComboBoxItem Content="Remote access · +1.312 h/job" Tag="1.312"/></ComboBox></StackPanel></Grid>
                        <TextBlock Text="Storm multipliers are scenario assumptions. Asset exposure uses local overhead/underground GIS data unless overridden." Foreground="#777D83" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="Additional needs" FontWeight="SemiBold" Margin="0,18,0,2"/><CheckBox x:Name="MedicalCheck" Content="I rely on electrically powered medical equipment"/><CheckBox x:Name="AccessCheck" Content="I may need extra assistance during an outage"/><CheckBox x:Name="CriticalCheck" Content="This is a critical community facility"/>
                        <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,12,0,2"/><CheckBox x:Name="SmsCheck" Content="Send SMS outage alerts (prototype)"/><CheckBox x:Name="EmailCheck" Content="Send email updates (prototype)"/>
                        <Button x:Name="PredictButton" Content="View my estimate" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="PredictButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="Safety" FontWeight="Bold"/><TextBlock Text="If you see a downed line, stay away and contact emergency services or your utility. Never approach or touch it." Foreground="#555B61" Margin="0,6,0,0"/></StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Grid Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your outage outlook" FontSize="18" FontWeight="Bold"/><TextBlock Text="Historical planning index · not a confirmed utility report" Foreground="#6D737A" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Edit details" Background="White" Foreground="#17191C" BorderBrush="#D7DBDE" BorderThickness="1" Click="EditButton_Click"/></Grid>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RELATIVE DAMAGE INDEX" FontSize="11" FontWeight="Bold" Foreground="#6D737A"/><TextBlock x:Name="RiskValue" Text="— / 100" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock x:Name="RiskConfidence" Text="Select a location in the data coverage." Foreground="#6D737A" FontSize="12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="RISK BAND" FontSize="11" FontWeight="Bold" Foreground="#6D737A"/><TextBlock x:Name="RiskBandValue" Text="Not available" FontSize="23" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Not an outage probability" Foreground="#6D737A" FontSize="12"/></StackPanel></Grid></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Restoration scenario" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="RestorationValue" Text="Not available" FontSize="20" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="RestorationDetailsText" Text="Select a location to estimate repair effort from the historical local damage mix." Foreground="#555B61" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="What affects the estimate" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="FactorsText" Text="Choose a location within the historical GIS coverage to calculate a relative score." Foreground="#555B61" Margin="0,7,0,0"/><TextBlock Text="How to read this score" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBlock Text="The baseline blends distance-weighted historical damage (75%) and nearby premises/network density (25%). Storm severity multiplies the baseline. Local overhead share supplies the default asset-exposure factor; scenario overrides can be selected. The 0–100 result is a relative index, not a calibrated outage probability or live forecast." Foreground="#555B61"/><TextBlock Text="Restoration assumptions" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBlock Text="ARCOS reports are historical. Work estimates use the supplied installation/removal averages, phase-aware pole hardware allowances, the 4.5 indirect labor multiplier, crew size, and access adders. The displayed duration applies an illustrative −25%/+35% buffer. Nearby sectionalizing devices are shown as restoration opportunities; actual switching sequence and step restoration are not simulated." Foreground="#555B61"/></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Prepare" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="GuidanceText" Text="Charge essential devices, keep flashlights and water available, and review your household outage plan." Foreground="#555B61" Margin="0,7,0,0"/><TextBlock Text="Alert eligibility" FontWeight="SemiBold" Margin="0,13,0,2"/><TextBlock x:Name="EligibilityText" Text="Select notification preferences to see the prototype status." Foreground="#555B61"/></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E4E7" BorderThickness="1" CornerRadius="8" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Ask the outage assistant" FontSize="15" FontWeight="Bold"/><TextBlock Text="  ·  Preview" Foreground="#858A8F" VerticalAlignment="Center" FontSize="12"/></StackPanel><Border Grid.Row="1" Background="#F5F6F7" CornerRadius="5" Padding="12" Margin="0,12,0,10"><TextBlock x:Name="ChatResponse" Text="I can help explain this estimate and suggest preparation steps. This assistant is a prototype and does not have live outage information." Foreground="#444A50"/></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" Margin="0" VerticalContentAlignment="Center" ToolTip="Ask about your estimate or preparation"/><Button Grid.Column="2" Content="Send" Padding="16,8" Click="SendButton_Click"/></Grid></Grid></Border>
                <TextBlock Text="Prototype only · Not an official outage notice or emergency service" Foreground="#777D83" FontSize="11" Margin="2,12,0,10"/>
            </StackPanel>
        </Grid></ScrollViewer>
    </Grid>
</Window>
