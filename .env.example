# Copy this file to .env and add your key. .env is ignored by Git.
# These defaults work with the OpenAI API. Local example: localhost:1234/v1 (key may be blank).
# Set OUTAGE_AI_MODEL to a model name accepted by your local server.
OUTAGE_AI_BASE_URL=https://api.openai.com/v1
OUTAGE_AI_MODEL=gpt-5-mini
OUTAGE_AI_API_KEY=put-your-api-key-here
