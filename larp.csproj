<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>larp</RootNamespace>
    <AssemblyName>larp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mapsui.Wpf" Version="5.1.0" />
    <ApplicationDefinition Include="src\App.xaml" />
    <None Update=".env.example" CopyToOutputDirectory="Never" />
    <None Update="src\Prediction\network_heatmap.csv" CopyToOutputDirectory="PreserveNewest" Link="Prediction\network_heatmap.csv" />
  </ItemGroup>
</Project>
